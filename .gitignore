# Generated forecast output - rebuilt twice daily on the VPS, never committed.
web/data/

# Raw forecast archive - lives on the VPS and syncs to the NAS.
# This is the validation record; it must not be in git history.
archive/

# Extracted from the committed hillcsv.zip on first use.
data/DoBIH_v18_5.csv

__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# Host configuration, differs per machine.
deploy/.env

# Validation working data: ~600 kB per station of raw METAR and model
# profiles, refetchable in minutes with `python scripts/validate.py --fetch`.
# The findings belong in docs/PLAN.md; the raw pull does not belong in git.
data/validation/

# Generated on every build by scripts/sitemap.py, with a lastmod that changes
# with the forecast. Committing it made the VPS working tree diverge from the
# repo within hours and blocked every git pull with "local changes would be
# overwritten". robots.txt stays tracked because it is deterministic: it only
# changes when the script does.
web/sitemap.xml

# Generated: one page per hill, rewritten by every build. About 7 MB of HTML
# that is a pure function of the forecast and the hill data, so it belongs in
# the build output rather than in git.
web/hill/

# Scratch from scripts/screenshots.py. Cleaned up on a successful run, but
# left behind if a capture is interrupted.
docs/screenshots/.chrome-profile/
docs/screenshots/.frame.html
