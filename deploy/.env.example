# Hill Weather host configuration.
#
# Copy to .env and edit. This file is the ONLY thing that should differ between
# one host and another, which is what makes migrating a config change rather
# than a code change.
#
#   cp deploy/.env.example deploy/.env

# Absolute path to the cloned repo. Relative paths work when you run
# docker compose from inside deploy/, but absolute is safer for a service that
# starts at boot.
PROJECT_ROOT=/opt/hillweather

# Where the raw forecast archive lives. This is the only irreplaceable state in
# the project: it cannot be refetched after the fact.
#
#   VPS      keep it local, rsync to the NAS periodically
#   homelab  point it straight at the NAS mount and skip the sync entirely
#
# ARCHIVE_DIR=/mnt/nas/hillweather/archive
ARCHIVE_DIR=/opt/hillweather/archive

# Host port the web container binds to. 5003 on the IONOS VPS because
# 5000, 5001 and 5002 are already taken there. Pick whatever is free on
# whichever host this ends up on.
WEB_PORT=5003

# Build times, UTC, comma separated.
#
# Twice a day, not four times: Open-Meteo weights API calls by variable count
# and location count, so 496 hills four times daily exceeds the free tier.
# 05:15 lands before anyone checks over breakfast, 16:15 catches the afternoon
# model run before people plan the next day.
RUN_TIMES=05:15,16:15

# Build immediately on startup if there is no forecast present yet. Leave this
# on: it means a freshly migrated host serves real data within minutes instead
# of showing nothing until the next scheduled slot.
RUN_ON_START=1
